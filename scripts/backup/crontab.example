# AnimeQuiz backup schedule for a Linux host with cron.
#
# Copy the lines below to /etc/cron.d/animequiz-backup (or your user's
# crontab) and adjust the project directory.
#
# The user running cron must be able to use the Docker daemon.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# Daily database dump at 03:00.
0 3 * * * root cd /opt/animequiz && docker compose --profile tools run --rm backup db >> backups/logs/cron.log 2>&1

# Weekly storage archive on Sunday at 03:30.
30 3 * * 0 root cd /opt/animequiz && docker compose --profile tools run --rm backup storage >> backups/logs/cron.log 2>&1
