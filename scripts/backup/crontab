# AnimeQuiz backup schedule, executed by Supercronic in the "scheduler"
# container. Times use the container timezone (TZ).
#
# Five fields: minute hour day-of-month month day-of-week.
# Day-of-week: 0 = Sunday.

# Daily database dump at 03:00.
0 3 * * * /scripts/backup.sh db

# Weekly paired backup on Sunday at 03:30.
30 3 * * 0 /scripts/backup.sh all

# Monthly restore check on the first day at 04:00.
0 4 1 * * /scripts/backup.sh restore-db --target AnimeQuiz_restore
