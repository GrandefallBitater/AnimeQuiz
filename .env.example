# Copy this file to .env and fill in the values.
# .env is ignored by git and must never be committed.

POSTGRES_DB=AnimeQuiz
POSTGRES_USER=animequiz
POSTGRES_PASSWORD=change-me

# Optional source credentials. Leave empty to use only Shikimori.
YUMMY_APP_TOKEN=
MAL_CLIENT_ID=

# Backup retention.
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_ARCHIVES=4

# Timezone for the backup scheduler. Examples: UTC, Europe/Kyiv, Europe/Berlin.
TZ=UTC
